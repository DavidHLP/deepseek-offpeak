#!/usr/bin/env node
// deepseek-offpeak status [--json]
// deepseek-offpeak refresh
//
// Answers from the local timetable, so it works with the shell closed and with
// api.deepseek.com unreachable. The schedule comes from lib/Schedule.js — the
// same module the bar and panel render — and the text and JSON come from
// lib/Status.js, so this cannot disagree with the widget. Its other input is the
// holiday table (lib/Holidays.js), read from the shared cache and refreshed from
// the same source the shell uses when that cache is cold or a week old; the
// table baked into that module answers when nothing can be fetched at all.
//
// The balance is the only part that touches DeepSeek, it is queried only when
// asked (status does read it, since that is the point of the command), and its
// failure is one line that leaves everything above it intact.

const fs = require("fs")
const path = require("path")
const os = require("os")
const { spawnSync } = require("child_process")
const Schedule = require(path.join(__dirname, "..", "lib", "Schedule.js"))
const Holidays = require(path.join(__dirname, "..", "lib", "Holidays.js"))
const Balance = require(path.join(__dirname, "..", "lib", "Balance.js"))
const Status = require(path.join(__dirname, "..", "lib", "Status.js"))

const USAGE = `Usage: deepseek-offpeak status [--json]
       deepseek-offpeak refresh

  status           Current pricing state, the countdown to the next change, and
                   the account balance when a key is available — from
                   DEEPSEEK_API_KEY, or from ~/.config/deepseek-offpeak/key.
  status --json    The same facts as one JSON object.
  refresh          Re-query the balance and print the status again.

The pricing state is computed locally from DeepSeek's published UTC timetable
and never from the API: status answers even when api.deepseek.com is
unreachable, and a balance failure gets its own line. The Chinese public
holiday dates the timetable needs are read from a cache the shell and this
command share, and fetched only when that cache is absent or a week old.
`

// Where the key came from, and the key itself: the process environment, then
// the key file — the same two places Service.qml reads, in the same order, so
// the widget and this command cannot query the API with different credentials.
// (Neither runs an interactive shell to pick the key out of ~/.bashrc: that
// executes the user's startup files as code, which a status readout has no
// business doing.)
function resolveApiKey() {
  const fromEnvironment = String(process.env[Balance.KEY_ENVIRONMENT_VARIABLE] || "")
  const fromEnvironmentResult = Balance.resolveKey(fromEnvironment)
  if (fromEnvironmentResult.status !== "pending") return fromEnvironmentResult

  const read = Balance.keyReadSpec(process.env.XDG_CONFIG_HOME, os.homedir())
  const child = spawnSync(read.command[0], read.command.slice(1), {
    encoding: "utf8",
    timeout: read.timeoutMs,
    maxBuffer: read.maxBuffer,
    killSignal: "SIGKILL"
  })
  return Balance.resolveKey(fromEnvironment, child.stdout || "", child.status === 0)
}

// The holiday table, read before fetched: the cached documents for this Beijing
// year and the next, merged over the table baked into lib/Holidays.js. The cache
// is the one Service.qml keeps, so the widget and this command schedule from the
// same dates, and a status call on a warm cache runs no process beyond the
// balance.
//
// A cache that is missing, unreadable, oversized, stale, or not the documented
// shape is what triggers a fetch: the same curl spec the shell runs, in the same
// bounded way, so the two cannot disagree about which year they hold or what
// counts as a valid document. A failed fetch is not an error to report — it
// leaves the previous table in place, which is exactly what a status readout
// needs from it.
function readHolidayCache(cacheHome, year) {
  const spec = Holidays.readSpec(cacheHome, year)
  let stats
  try {
    stats = fs.statSync(spec.path)
  } catch (e) {
    return null
  }
  if (!stats.isFile() || stats.size > Holidays.MAX_CACHE_BYTES) return null

  let text
  try {
    text = fs.readFileSync(spec.path, "utf8")
  } catch (e) {
    return null
  }
  if (!Holidays.parse(text).ok) return null
  return { text: text, stale: Date.now() - stats.mtimeMs >= Holidays.STALE_AFTER_MS }
}

function fetchHolidays(cacheHome, year) {
  const spec = Holidays.fetchSpec(cacheHome, year)
  spawnSync(spec.command[0], spec.command.slice(1), {
    encoding: "utf8",
    timeout: spec.timeoutMs,
    maxBuffer: Holidays.MAX_CACHE_BYTES,
    killSignal: "SIGKILL"
  })
}

function resolveHolidays(nowMs) {
  const cacheHome = Holidays.cacheHome(process.env.XDG_CACHE_HOME, os.homedir())
  const thisYear = Schedule.beijingYear(nowMs)
  const fetchNextYear = Schedule.beijingYear(nowMs + Holidays.NEXT_YEAR_FETCH_LEAD_MS) > thisYear

  const texts = []
  for (const year of [thisYear, thisYear + 1]) {
    // The next year is worth a fetch only once its arrangement has been
    // published; before that the request is a guaranteed 404, once per status
    // call. Its cache is still read whenever it is there.
    const mayFetch = year === thisYear || fetchNextYear
    let cached = readHolidayCache(cacheHome, year)
    if (mayFetch && (!cached || cached.stale)) {
      fetchHolidays(cacheHome, year)
      const reread = readHolidayCache(cacheHome, year)
      if (reread) cached = reread
    }
    texts.push(cached ? cached.text : "")
  }
  return Holidays.tableFromTexts(texts)
}

function queryBalance(key) {
  if (key.status !== "resolved") return Balance.errorState(key.error || Balance.ERROR_MISSING_API_KEY)

  const request = Balance.requestSpec()
  const child = spawnSync(request.command[0], request.command.slice(1), {
    encoding: "utf8",
    timeout: request.timeoutMs,
    maxBuffer: request.maxBuffer,
    killSignal: "SIGKILL",
    env: Balance.requestEnvironment(process.env, os.homedir(), key.key)
  })
  if (child.error) return Balance.stateFromProcessError(child.error, 0)
  const exitCode = child.status
  const completionMs = exitCode === null || exitCode === undefined ? 0 : Date.now()
  return Balance.stateFromResponse(exitCode, child.stdout || "", completionMs, 0)
}

function main(argv) {
  const command = argv[0]
  if (!command || command === "-h" || command === "--help" || command === "help") {
    process.stdout.write(USAGE)
    return 0
  }
  if (command !== "status" && command !== "refresh") {
    process.stderr.write(`deepseek-offpeak: unknown command '${command}'\n\n${USAGE}`)
    return 2
  }

  // One instant for the whole report. Calling Date.now() twice — once for the
  // schedule and once inside statusState — can straddle a boundary and label a
  // peak state with off-peak clocks and a negative-looking countdown.
  const nowMs = Date.now()
  const key = resolveApiKey()
  const holidays = resolveHolidays(nowMs)
  const state = Schedule.statusState(Schedule.stateAt(nowMs, holidays),
    { nowMs: nowMs, notificationsEnabled: null, apiKeySource: key.source,
      holidays: holidays, holidayYears: Holidays.yearsOf(holidays).join(", ") })
  const balance = queryBalance(key)

  if (argv.includes("--json")) {
    process.stdout.write(JSON.stringify(Status.object(state, balance), null, 2) + "\n")
  } else {
    process.stdout.write(Status.text(state, balance) + "\n")
  }
  return 0
}

process.exit(main(process.argv.slice(2)))
